{
  "name": "magic-writer",
  "version": "0.1.0",
  "private": true,
  "description": "AI 驱动的桌面端小说创作工具",
  "scripts": {
    "dev": "pnpm --filter @magic-writer/desktop dev",
    "build": "pnpm --filter @magic-writer/desktop build",
    "start": "pnpm --filter @magic-writer/desktop start",
    "build:mac": "pnpm --filter @magic-writer/desktop build:mac",
    "build:win": "pnpm --filter @magic-writer/desktop build:win",
    "build:linux": "pnpm --filter @magic-writer/desktop build:linux"
  },
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "better-sqlite3"
    ]
  }
}
